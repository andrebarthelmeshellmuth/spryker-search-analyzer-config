{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Edit ' ~ (filterLabel | default('')) ~ ' -- ' ~ sourceIdentifier ~ ' / ' ~ storeName %}
{% block section_title %}{{ widget_title | trans }}{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: widget_title } %}
        {% block widget_content %}
            {% import '@SearchAnalyzerConfig/Config/_macros.twig' as macros %}
            <p><a href="{{ url('/search-analyzer-config/config/edit', { source: sourceIdentifier, store: storeName }) }}">{{ '&larr; Back to edit' | trans | raw }}</a></p>
            {{ macros.sharedWith(slotAvailability, slotName) }}
            <p>Saving only STAGES this config -- it does not touch a live index. Use "Apply" on the overview page afterward.</p>

            {% if missingSlotWarnings is defined and missingSlotWarnings is not empty %}
                <div class="alert alert-warning">
                    <strong>{{ 'Not saved yet -- this field is active but not referenced by every analyzer:' | trans }}</strong>
                    <ul>
                        {% for warning in missingSlotWarnings %}
                            <li>{{ warning }}</li>
                        {% endfor %}
                    </ul>
                    <p class="text-muted">{{ 'This may be intentional (e.g. wired into some analyzers but not others) -- click "Save anyway" below to confirm and save as-is, or adjust the field/schema first.' | trans }}</p>
                </div>
            {% endif %}

            {{ form_start(editFormView) }}
                {{ form_widget(editFormView.sourceIdentifier) }}
                {{ form_widget(editFormView.storeName) }}
                {{ form_widget(editFormView.confirmed, { id: 'sac-edit-filter-confirmed' }) }}

                {% if editFormView.stemmerLanguage is defined %}{{ form_row(editFormView.stemmerLanguage) }}{% endif %}
                {% if editFormView.normalizationFilter is defined %}{{ form_row(editFormView.normalizationFilter) }}{% endif %}
                {% if editFormView.stopwordsMode is defined %}{{ form_row(editFormView.stopwordsMode) }}{% endif %}
                {% if editFormView.stopwordsBuiltinLanguage is defined %}{{ form_row(editFormView.stopwordsBuiltinLanguage) }}{% endif %}
                {% if editFormView.decompoundEnabled is defined %}{{ form_row(editFormView.decompoundEnabled) }}{% endif %}

                {% if editFormView.listText is defined %}
                    {{ form_row(editFormView.listText) }}
                    {% if filterType == 'stopwords' %}
                        <p class="text-muted">{{ '(only takes effect when mode = Custom list)' | trans }}</p>
                    {% elseif filterType == 'decompound' %}
                        <p class="text-muted">{{ '(only takes effect when decompounding is enabled)' | trans }}</p>
                    {% endif %}
                {% endif %}

                <button type="submit" class="btn btn-primary">{{ 'Save' | trans }}</button>
                {% if missingSlotWarnings is defined and missingSlotWarnings is not empty %}
                    <button type="submit" class="btn btn-outline-warning"
                        onclick="document.getElementById('sac-edit-filter-confirmed').value = '1';">{{ 'Save anyway' | trans }}</button>
                {% endif %}
            {{ form_end(editFormView) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
